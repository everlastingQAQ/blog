---
import { getCollection } from 'astro:content'

import { cn } from 'astro-pure/utils'
import DocsTree from '@/components/docs/DocsTree.astro'
import { buildDocsNavigation } from '@/utils/docs-navigation'

export const prerender = true
export const partial = true

type Props = {
  class?: string
  defaultOpenDepth?: number
  title?: boolean
}

const { class: className, defaultOpenDepth = 1, title = true, ...props } = Astro.props
const docsCollection = await getCollection('docs', ({ data }) => !data.draft)
const groups = buildDocsNavigation(docsCollection)
---

<nav class={cn('not-prose', className)} aria-label='文档目录' {...props}>
  {title && <h2 class='text-foreground font-medium'>DOCS</h2>}
  <div class='mt-4'>
    <DocsTree {groups} currentPath={Astro.url.pathname} {defaultOpenDepth} />
  </div>
</nav>
