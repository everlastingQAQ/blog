---
import { getBlogCollection } from 'astro-pure/server'
import { cn } from 'astro-pure/utils'

import cs61bManifest from '../../content/docs/cs61b/2021spring/.cs61b-import-manifest.json'

export const prerender = true
export const partial = true

const docsCollection = await getBlogCollection('docs')

const cs61bPrefix = 'cs61b/2021spring'
const cs61bCategoryOrder = ['课程教材', '实验', '项目']
const cs61bNavigation = new Map(cs61bManifest.navigation.map((item) => [item.source, item]))

const getCS61BSource = (id: string) =>
  id === cs61bPrefix ? 'index.md' : `${id.slice(cs61bPrefix.length + 1)}.md`

const cs61bDocs = docsCollection
  .filter((doc) => doc.id === cs61bPrefix || doc.id.startsWith(`${cs61bPrefix}/`))
  .map((doc) => ({ doc, navigation: cs61bNavigation.get(getCS61BSource(doc.id)) }))
  .sort((a, b) => (a.navigation?.order ?? 0) - (b.navigation?.order ?? 0))

const cs61bLandingDocs = cs61bDocs.filter((item) => {
  const firstLabel = item.navigation?.labels[0]
  return firstLabel === '首页' || firstLabel === '中文课程主页'
})

const cs61bDocsByCategory = cs61bCategoryOrder.map((title) => ({
  title,
  docs: cs61bDocs.filter((item) => item.navigation?.labels[0] === title)
})).filter(({ docs }) => docs.length > 0)

type Props = {
  title?: boolean
  class?: string
}

const { title = true, class: className, ...props } = Astro.props
---

<docs-toc class={cn('not-prose', className)} {...props}>
  {title && <h2 class='text-foreground font-medium'>DOCS</h2>}
  <ul class='mt-4 flex flex-col gap-y-5'>
    {
  cs61bDocs.length > 0 && (
    <li>
      <details class='docs-root' open>
        <summary class='docs-root-summary'>
          <span>CS61B Spring 2021 中文文档</span>

          <svg
            class='docs-root-arrow'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <polyline points='9 18 15 12 9 6'></polyline>
          </svg>
        </summary>

        <div class='docs-root-content'>
          {cs61bLandingDocs.map(({ doc }) => (
            <div class='docs-item flex relative ms-2 px-3 py-1 text-foreground/75 transition-all rounded-2xl'>
              <a
                class='flex-1 hover:text-foreground'
                href={`/docs/${doc.id}/`}
              >
                {doc.data.title}
              </a>
            </div>
          ))}

          <ul class='flex flex-col'>
            {cs61bDocsByCategory.map(({ title, docs }) => (
              <li>
                <details class='docs-category'>
                  <summary class='docs-category-summary'>
                    <span>{title}</span>

                    <svg
                      class='docs-category-arrow'
                      xmlns='http://www.w3.org/2000/svg'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
                    >
                      <polyline points='9 18 15 12 9 6'></polyline>
                    </svg>
                  </summary>

                  <ul class='docs-category-content'>
                    {docs.map(({ doc }) => (
                      <li class='docs-item flex relative ms-2 px-3 py-1 text-foreground/75 transition-all rounded-2xl'>
                        <a
                          class='flex-1 hover:text-foreground'
                          href={`/docs/${doc.id}/`}
                        >
                          {doc.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </li>
  )
}
  </ul>
</docs-toc>

<style>
  docs-toc .docs-item::before {
    content: '';
    display: block;
    position: absolute;
    top: 5%;
    bottom: 5%;
    left: -0.5rem;
    width: 2px;
    background-color: hsl(var(--input) / var(--un-bg-opacity));
  }

  docs-toc .docs-item > a {
    display: -webkit-box;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  docs-toc :global(.docs-item.docs-hl) {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
    font-weight: 500;
    & a {
      color: hsl(var(--primary) / var(--un-text-opacity));
    }

    &::before {
      background-color: hsl(var(--primary) / var(--un-bg-opacity));
    }
  }

  /* ===== CS61B 最外层 ===== */

docs-toc .docs-root {
  width: 100%;
}

docs-toc .docs-root-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0.8rem 0.25rem;

  cursor: pointer;
  user-select: none;
  list-style: none;

  color: hsl(var(--foreground) / 0.85);
  font-size: 1rem;
  font-weight: 500;

  border-bottom: 1px solid hsl(var(--border) / 0.6);

  transition:
    color 0.2s ease,
    padding-left 0.2s ease;
}

docs-toc .docs-root-summary:hover {
  color: hsl(var(--foreground));
  padding-left: 0.4rem;
}

docs-toc .docs-root-summary::-webkit-details-marker {
  display: none;
}

docs-toc .docs-root-arrow {
  width: 1rem;
  height: 1rem;

  flex-shrink: 0;

  color: hsl(var(--muted-foreground));

  transition:
    transform 0.25s ease,
    color 0.2s ease;
}

docs-toc .docs-root[open] > .docs-root-summary .docs-root-arrow {
  transform: rotate(90deg);
  color: hsl(var(--foreground));
}

docs-toc .docs-root-content {
  padding-top: 0.6rem;
  animation: docs-open 0.2s ease;
}


/* ===== 二级分类 ===== */

docs-toc .docs-category {
  width: 100%;
}

docs-toc .docs-category-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0.75rem 0.25rem;

  cursor: pointer;
  user-select: none;
  list-style: none;

  color: hsl(var(--foreground) / 0.8);
  font-size: 1rem;
  font-weight: 500;

  border-bottom: 1px solid hsl(var(--border) / 0.6);

  transition:
    color 0.2s ease,
    padding-left 0.2s ease;
}

docs-toc .docs-category-summary:hover {
  color: hsl(var(--foreground));
  padding-left: 0.4rem;
}

docs-toc .docs-category-summary::-webkit-details-marker {
  display: none;
}

docs-toc .docs-category-arrow {
  width: 1rem;
  height: 1rem;

  flex-shrink: 0;

  color: hsl(var(--muted-foreground));

  transition:
    transform 0.25s ease,
    color 0.2s ease;
}

docs-toc .docs-category[open] > .docs-category-summary {
  color: hsl(var(--foreground));
}

docs-toc .docs-category[open] > .docs-category-summary .docs-category-arrow {
  transform: rotate(90deg);
  color: hsl(var(--foreground));
}

docs-toc .docs-category-content {
  display: flex;
  flex-direction: column;

  padding-top: 0.35rem;
  padding-bottom: 0.7rem;

  animation: docs-open 0.2s ease;
}


/* ===== 展开动画 ===== */

@keyframes docs-open {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

  docs-toc .docs-category > summary::-webkit-details-marker {
    display: none;
  }

    docs-toc .docs-category[open] > summary .category-arrow {
    transform: rotate(90deg);
  }
</style>

<script>
  class DocsTOC extends HTMLElement {
    link: string = ''

    constructor() {
      super()
      this.link = window.location.pathname
    }

    connectedCallback() {
      const links = this.querySelectorAll('a')
      links.forEach((link) => {
        if (link.getAttribute('href') === this.link) {
          link.parentElement?.classList.add('docs-hl')
        }
      })
    }
  }

  customElements.define('docs-toc', DocsTOC)
</script>
