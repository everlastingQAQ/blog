---
import type { DocsNavigationGroup } from '@/utils/docs-navigation'
import { groupContainsPath, normalizeDocsPath } from '@/utils/docs-navigation'

type Props = {
  currentPath: string
  defaultOpenDepth?: number
  depth?: number
  groups: DocsNavigationGroup[]
}

const { currentPath, defaultOpenDepth = 1, depth = 0, groups } = Astro.props
const normalizedCurrentPath = normalizeDocsPath(currentPath)
---

<ul class:list={['docs-tree', depth > 0 && 'docs-tree-nested']}>
  {
    groups.map((group) => (
      <li class='docs-group'>
        <details open={depth < defaultOpenDepth || groupContainsPath(group, normalizedCurrentPath)}>
          <summary class='docs-summary'>
            <span>{group.label}</span>
            <svg
              class='docs-arrow'
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <polyline points='9 18 15 12 9 6' />
            </svg>
          </summary>

          <div class='docs-group-content'>
            {group.items.length > 0 && (
              <ul class='docs-items'>
                {group.items.map((item) => {
                  const active = normalizeDocsPath(item.href) === normalizedCurrentPath
                  return (
                    <li class:list={['docs-item', active && 'docs-hl']}>
                      <a href={item.href} aria-current={active ? 'page' : undefined}>
                        {item.label}
                      </a>
                    </li>
                  )
                })}
              </ul>
            )}

            {group.children.length > 0 && (
              <Astro.self
                groups={group.children}
                currentPath={normalizedCurrentPath}
                {defaultOpenDepth}
                depth={depth + 1}
              />
            )}
          </div>
        </details>
      </li>
    ))
  }
</ul>

<style>
  .docs-tree {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-tree-nested {
    margin-left: 0.5rem;
    padding-left: 0.5rem;
    border-left: 1px solid hsl(var(--border) / 0.6);
  }

  .docs-group,
  .docs-items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.65rem 0.25rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    color: hsl(var(--foreground) / 0.85);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5rem;
    border-bottom: 1px solid hsl(var(--border) / 0.6);
    transition:
      color 0.2s ease,
      padding-left 0.2s ease;
  }

  .docs-summary:hover {
    padding-left: 0.4rem;
    color: hsl(var(--foreground));
  }

  .docs-summary::-webkit-details-marker {
    display: none;
  }

  .docs-arrow {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: hsl(var(--muted-foreground));
    transition:
      transform 0.25s ease,
      color 0.2s ease;
  }

  details[open] > .docs-summary .docs-arrow {
    transform: rotate(90deg);
    color: hsl(var(--foreground));
  }

  .docs-group-content {
    padding: 0.35rem 0 0.45rem;
    animation: docs-open 0.2s ease;
  }

  .docs-item {
    position: relative;
    display: flex;
    margin-left: 0.5rem;
    padding: 0.25rem 0.75rem;
    color: hsl(var(--foreground) / 0.75);
    border-radius: 1rem;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .docs-item::before {
    content: '';
    position: absolute;
    top: 5%;
    bottom: 5%;
    left: -0.5rem;
    width: 2px;
    background-color: hsl(var(--input) / var(--un-bg-opacity));
  }

  .docs-item > a {
    display: -webkit-box;
    flex: 1;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .docs-item:hover {
    color: hsl(var(--foreground));
  }

  .docs-item.docs-hl {
    color: hsl(var(--primary) / var(--un-text-opacity));
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
    font-weight: 500;
  }

  .docs-item.docs-hl::before {
    background-color: hsl(var(--primary) / var(--un-bg-opacity));
  }

  @keyframes docs-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
