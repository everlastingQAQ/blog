---
import { render, type CollectionEntry } from 'astro:content'

import { MediumZoom } from 'astro-pure/advanced'
import { TOC } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/ContentLayout.astro'
import DocsContents from '@/components/docs/DocsContents.astro'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection('docs'))
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = {
  post: CollectionEntry<'docs'>
}

const { post } = Astro.props as Props
const { Content, headings } = await render(post)
const { description, title } = post.data

const editPath = (post.filePath ?? `src/content/docs/${post.id}.md`).replaceAll('\\', '/')
const action =
  post.data.repository ??
  ({
    label: '在 GitHub 上编辑',
    url: `https://github.com/everlastingQAQ/blog/edit/main/${editPath}`
  } as const)
---

<PageLayout meta={{ description, title }} back='/docs/' showSidebar>
  <Fragment slot='sidebar'>
    {headings.length > 0 && <TOC {headings} />}
    <DocsContents class='docs-toc block mt-3' />
  </Fragment>

  <Fragment slot='header'>
    <h1 class='text-3xl font-medium sm:mb-2 sm:text-4xl'>
      {title}
    </h1>
  </Fragment>

  <Content />

  <div slot='bottom'>
    <Button title={action.label} href={action.url} class='px-3 py-2' style='font-size:1rem'>
      {/* mingcute:edit-2-line */}
      <svg
        slot='before'
        xmlns='http://www.w3.org/2000/svg'
        width='20'
        height='20'
        viewBox='0 0 24 24'
      >
        <path
          fill='currentColor'
          d='M13.896 3.03a2 2 0 0 1 2.701-.117l.127.117l4.243 4.243a2 2 0 0 1 .117 2.7l-.117.128l-10.314 10.314a2 2 0 0 1-1.238.578L9.239 21H4.006a1.01 1.01 0 0 1-1.004-.9l-.006-.11v-5.233a2 2 0 0 1 .467-1.284l.12-.13L13.895 3.03ZM12.17 7.584l-7.174 7.174V19H9.24l7.174-7.174l-4.243-4.243Zm3.14-3.14L13.584 6.17l4.243 4.243l1.726-1.726z'
        ></path>
      </svg>
      {action.label}
    </Button>
  </div>
</PageLayout>
<MediumZoom />

<style>
  @media (min-width: 1300px) {
    :global(
      main, .bottom { transform: translateX(7.9rem); }
      #sidebar { overflow: inherit; }
      toc-heading { height: 100%; display: flex; flex-direction: column; }
      toc-heading > ul { overflow-y: scroll; }
    )
    .docs-toc {
      position: fixed;
      top: 0;
      left: -64rem;
      width: 12rem;
      margin-top: 0;
      max-height: calc(100vh - 7rem);
      overflow-y: scroll;
      padding-right: 1rem !important;
    }
  }
</style>
