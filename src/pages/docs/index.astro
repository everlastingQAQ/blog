---
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import DocsContents from '@/components/docs/DocsContents.astro'
import { integ } from '@/site-config'

const meta = {
  title: '文档中心',
  description: '本站文档、教程与学习资料'
}
---

<PageLayout {meta}>
  <Button title='返回' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>文档中心</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <DocsContents title={false} />

      <h2 class='mt-10 text-xl font-medium'>RSS</h2>
      <p>
        <a href='/docs/rss.xml' target='_blank' aria-label='订阅文档 RSS'><Icon name='rss' /> </a>
      </p>
    </div>
  </main>
</PageLayout>
