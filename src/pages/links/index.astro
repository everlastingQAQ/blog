---
import links from '@/public/links.json'
import config from 'virtual:config'

import PageLayout from '@/layouts/CommonPage.astro'
import FriendList from '@/components/links/FriendList.astro'

const { friends } = links
const linksConf = config.integ.links
---

<PageLayout title='友链'>
  <p>以下友链随机排序。</p>

  <FriendList list={friends[0]} />

  <h2 id='apply-links'>交换友链</h2>

  <p>
    如果你也有自己的博客或个人网站，欢迎交换友链。
  </p>

  <p>本站信息（点击即可复制）：</p>

  <blockquote
    class='not-prose grid grid-cols-[auto_1fr] gap-x-2 gap-y-1 break-words border-s-4 ps-4'
  >
    {
      linksConf.applyTip.map(({ name, val }) => {
        const script = `
          navigator.clipboard.writeText('${val}');
          document.dispatchEvent(
            new CustomEvent('toast', {
              detail: { message: '已复制：${val}' }
            })
          )
        `

        return (
          <>
            <span class='text-end'>{name}：</span>
            <samp class='cursor-pointer hover:text-primary' onclick={script}>
              {val}
            </samp>
          </>
        )
      })
    }
  </blockquote>

  <p>
    交换友链前，希望你的站点：
  </p>

  <ul>
    <li>已经添加本站友链</li>
    <li>站点可以正常访问，并拥有稳定的域名</li>
    <li>有一定数量的原创内容</li>
    <li>近期仍有更新</li>
    <li>内容符合法律法规</li>
  </ul>

  <p>
    如果符合以上条件，可以通过 GitHub 联系我申请交换友链。
  </p>
</PageLayout>

<style is:global>
  #main-container {
    min-height: auto !important;
  }

  #sidebar {
    display: none !important;
    height: auto !important;
  }
</style>