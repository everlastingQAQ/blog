---
import { Image } from 'astro:assets'
import { Button, Icon } from 'astro-pure/user'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'github-activity', text: 'GitHub 活动' },
  { depth: 2, slug: 'projects', text: '项目实践' },
  { depth: 2, slug: 'learning', text: '课程学习' }
]
---

<PageLayout title='项目' {headings} view>
  <p>
    这里记录我在学习计算机过程中做过的项目、工具，以及一些课程实践。
  </p>

  <p>
    部分项目使用了 AI 辅助开发，主要用来快速验证想法和推进实现。
    它们并不都很成熟，我也会继续通过阅读、调试、重构和补充测试，
    把“能跑起来”的代码逐渐变成自己真正理解、能够维护的项目。
  </p>

  <h2 id='github-activity'>GitHub 活动</h2>

  <a
    href='https://github.com/everlastingQAQ'
    target='_blank'
    rel='noopener noreferrer'
    class='not-prose block'
  >
    <div
      class='overflow-hidden rounded-xl border bg-background px-5 py-4 transition-colors hover:bg-muted/30'
    >
      <Image
        src='https://ghchart.rshah.org/2ea043/everlastingQAQ'
        format='svg'
        alt='Everlasting GitHub Contributions'
        inferSize
        loading='lazy'
        class='m-0 w-full'
      />
    </div>
  </a>

  <h2 id='projects'>项目实践</h2>

  <ProjectSection
    projects={[
      {
        name: 'WUST Algo Tracker',
        description:
          'WUST ACM 算法训练数据平台后端',
        links: [
          {
            type: 'github',
            href: 'https://github.com/WUSTACM/WUST-Algo-tracker'
          }
        ]
      },
      {
        name: 'WUST Algo Frontend',
        description:
          'WUST ACM 算法训练数据平台前端',
        links: [
          {
            type: 'github',
            href: 'https://github.com/WUSTACM/WUST-Algo-Frontend'
          }
        ]
      },
      {
        name: 'Online Judge Platform',
        description:
          '一个面向训练与比赛场景的在线评测平台实验项目',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/Online-Judge-platform'
          }
        ]
      },
      {
        name: 'ChatGPT Local Coding Agent',
        description:
          '探索让 ChatGPT 网页端与本地文件交互的本地编码 Agent',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/chatgpt-local-coding-agent'
          }
        ]
      },
      {
        name: 'Extract & Delete',
        description:
          '一个 Windows 11 压缩包小工具',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/ExtractAndDelete'
          },
          {
            type: 'release',
            href: 'https://github.com/everlastingQAQ/ExtractAndDelete/releases'
          }
        ]
      }
    ]}
  />

  <div class='mt-5'>
    <Button
      title='查看全部 GitHub 仓库'
      href='https://github.com/everlastingQAQ?tab=repositories'
      target='_blank'
      class='w-fit'
    >
      <Icon class='size-5' name='github-circle' slot='before' />
    </Button>
  </div>

  <h2 id='learning'>课程学习</h2>

  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'CS61A',
        description:
          '伯克利大学的计算机科学入门课程，注重抽象思维、程序设计与编程范式',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/CS61A'
          },
          {
            type: 'site',
            href: 'https://cs61a.org/'
          }
        ]
      },
      {
        name: 'CS61B',
        description:
          '伯克利大学的数据结构与算法课程，注重数据结构设计、算法分析与大型程序开发',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/CS61B'
          },
          {
            type: 'site',
            href: 'https://sp21.datastructur.es/'
          }
        ]
      },
      {
        name: 'CSAPP',
        description:
          '卡内基梅隆大学的计算机系统课程，注重程序底层运行机制与系统设计',
        links: [
          {
            type: 'github',
            href: 'https://github.com/everlastingQAQ/CSAPP'
          },
          {
            type: 'site',
            href: 'https://csapp.cs.cmu.edu/'
          }
        ]
      }
    ]}
  />
</PageLayout>
